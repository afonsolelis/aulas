# Copie para .env (que deve estar no .gitignore) e troque as senhas.
# Gere senhas fortes com: openssl rand -base64 24

# ---------- RabbitMQ (local: docker compose) ----------
RABBITMQ_USER=iot
RABBITMQ_PASSWORD=troque-esta-senha
# URL AMQP usada pelos processos Python (pika.URLParameters)
AMQP_URL=amqp://iot:troque-esta-senha@localhost:5672/%2F

# Topologia (nomes combinados na spec)
EXCHANGE_LEITURAS=iot.leituras
EXCHANGE_DLX=iot.dlx
FILA_BRUTAS=leituras.brutas
FILA_VALIDAS=leituras.validas
FILA_DLQ=leituras.dlq
# prefetch do armazenador precisa ser >= LOTE_MAX_LINHAS, senão o lote nunca enche
PREFETCH=1000

# ---------- ClickHouse (local: docker compose) ----------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_DB=iot
CLICKHOUSE_USER=iot
CLICKHOUSE_PASSWORD=troque-esta-senha-tambem

# ---------- Lote do armazenador ----------
# Valores iniciais para a demonstração; ajuste com medição, não por palpite.
LOTE_MAX_LINHAS=1000
LOTE_MAX_SEGUNDOS=5

# ---------- Simulador ----------
SENSORES=12
INTERVALO_SEGUNDOS=1
TAXA_INVALIDAS=0.05
TAXA_DUPLICADAS=0.03

# ---------- Railway (preencha no painel/CLI, nunca aqui com valor real) ----------
# Dentro do projeto Railway, os processos usam a rede privada:
#   AMQP_URL=amqp://<usuario>:<senha>@rabbitmq.railway.internal:5672/%2F
#   CLICKHOUSE_HOST=clickhouse.railway.internal  CLICKHOUSE_PORT=8123  CLICKHOUSE_SECURE=false
# Do Codespace para o ClickHouse publicado (só HTTPS):
#   CLICKHOUSE_HOST=<dominio>.up.railway.app  CLICKHOUSE_PORT=443  CLICKHOUSE_SECURE=true
