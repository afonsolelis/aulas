# Copie para .env (local) e para .env.railway (MinIO publicado na Aula 01).
# Nenhum dos dois arquivos entra no Git: confira o .gitignore antes do primeiro commit.

# --- Usado pelo docker compose (MinIO local) ---
MINIO_ROOT_USER=aluno
# Gere uma senha com: openssl rand -base64 24
MINIO_ROOT_PASSWORD=troque-esta-senha

# --- Usado pelo coletor (local ou Railway) ---
# Local: http://localhost:9000
# Railway: https://<dominio-gerado-pelo-railway-para-a-porta-9000>
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aluno
S3_SECRET_KEY=troque-esta-senha
BUCKET_RAW=raw
# Região padrão aceita pelo MinIO; o boto3 exige algum valor.
S3_REGION=us-east-1

# --- Parâmetros do coletor ---
COLETOR_VERSAO=0.1.0
# Pasta onde o gerar_lotes.py deixa os lotes (o papel do SFTP do provedor)
POUSO_DIR=pouso
