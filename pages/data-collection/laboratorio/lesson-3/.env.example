# Copie para .env (que deve estar no .gitignore) e preencha.
# Nunca versione o .env nem cole estes valores em prompt, print ou commit.

# --- MinIO local (docker compose) ---
MINIO_ROOT_USER=aula03admin
MINIO_ROOT_PASSWORD=troque-por-uma-senha-forte
# gere com: openssl rand -base64 24

# --- Destino usado pelos coletores ---
# Local:   http://localhost:9000
# Railway: https://<dominio-gerado-pelo-railway>  (saída de: railway domain --port 9000 --service minio)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aula03admin
S3_SECRET_KEY=troque-por-uma-senha-forte
# Região padrão aceita pelo MinIO; o boto3 exige algum valor.
S3_REGION=us-east-1
BUCKET_RAW=raw
BUCKET_BRONZE=bronze
# Bucket só para os testes de gravação (Etapa 13); nunca use raw ou bronze nos testes.
BUCKET_TESTE=teste

# --- Coleta educada ---
# Identifique o coletor e um contato do grupo (e-mail institucional ou URL do repositório).
USER_AGENT=inteli-aula03-coletor/0.1 (+https://github.com/<org>/<repo>)
SCRAPER_INTERVALO_SEGUNDOS=1.0
# Lista de categorias separadas por vírgula (ex.: mystery_3,poetry_23) para testes rápidos.
# Vazio = todas as categorias. A coleta completa faz cerca de 1.081 requisições.
SCRAPER_CATEGORIAS=
HTTP_TIMEOUT_CONNECT=5
HTTP_TIMEOUT_READ=20
HTTP_MAX_TENTATIVAS=4

# --- Fontes ---
BOOKS_BASE_URL=https://books.toscrape.com/
PTAX_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
PTAX_MOEDA=GBP
PTAX_JANELA_DIAS=7
