<!-- Aula 05 · Coleção nomeada "lake": o ClickHouse lê os manifestos do lake no RustFS com s3(lake).
     As chaves vêm do ambiente do contêiner (S3_ACCESS_KEY e S3_SECRET_KEY), nunca do SQL. -->
<clickhouse>
    <named_collections>
        <lake>
            <url>http://rustfs:9000/raw/_manifestos/ingestao/*/*.json</url>
            <access_key_id from_env="S3_ACCESS_KEY"/>
            <secret_access_key from_env="S3_SECRET_KEY"/>
            <format>JSONAsString</format>
        </lake>
    </named_collections>
</clickhouse>
