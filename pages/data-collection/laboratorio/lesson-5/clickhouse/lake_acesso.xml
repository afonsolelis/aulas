<!-- Aula 05 · Libera a coleção nomeada para o usuário do laboratório.
     O nome do usuário é o CLICKHOUSE_USER do .env (padrão: ingestao). -->
<clickhouse>
    <users>
        <ingestao>
            <named_collection_control>1</named_collection_control>
        </ingestao>
    </users>
</clickhouse>
