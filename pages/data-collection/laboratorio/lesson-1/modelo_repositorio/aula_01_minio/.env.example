# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
#   cp .env.example .env
# Gere senhas com:  openssl rand -hex 24

# MinIO local (docker compose)
MINIO_ROOT_USER=admin_local
MINIO_ROOT_PASSWORD=troque_por_uma_senha_gerada

# MinIO do grupo no Railway (preencha depois do deploy)
# Endpoint = domínio gerado por `railway domain --port 9000`, com https://
MINIO_RAILWAY_ENDPOINT=https://seu-servico.up.railway.app
MINIO_RAILWAY_USER=troque_pelo_usuario_do_railway
MINIO_RAILWAY_PASSWORD=troque_pela_senha_do_railway
