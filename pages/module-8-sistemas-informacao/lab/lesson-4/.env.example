# Copy to .env and replace the password (openssl rand -base64 24).
# .env is never committed.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-now

# Client side: the same credentials, used by DuckDB and boto3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-now
S3_REGION=us-east-1
S3_USE_SSL=false
LAKE_BUCKET=pharmacy-lake

# Test Data Warehouse (a DuckDB database file, ignored by git)
WAREHOUSE_PATH=warehouse/pharmacy.duckdb
