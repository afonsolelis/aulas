# Copy to .env and replace the passwords (openssl rand -base64 24).
# .env is never committed, pasted in a prompt or shown on the projector.

# RustFS (lake, S3 API). The same pair is the login of the console
# (http://localhost:9001/rustfs/console/) and the credentials of DuckDB and boto3.
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=change-me-now
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_USE_SSL=false
LAKE_BUCKET=pharmacy-lake

# ClickHouse (tactical copy of the Silver layer)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=silver
CLICKHOUSE_PASSWORD=change-me-too
CLICKHOUSE_DATABASE=silver

# Local DuckDB file with the views of the 3NF and Data Vault models (ignored by git)
WAREHOUSE_PATH=warehouse/silver.duckdb
