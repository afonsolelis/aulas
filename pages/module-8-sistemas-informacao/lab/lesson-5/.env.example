# Copy to .env and replace the passwords (openssl rand -base64 24).
# .env is never committed, pasted in a prompt or shown on the projector.

# RustFS (lake, S3 API). The same pair is the login of the console
# (http://localhost:9001/rustfs/console/) and the credentials of DuckDB, boto3 and
# of the s3() table function of ClickHouse.
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=change-me-now
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_USE_SSL=false
LAKE_BUCKET=olist-lake
# Address of RustFS as seen from inside the ClickHouse container (same compose network)
S3_ENDPOINT_FROM_CLICKHOUSE=http://rustfs:9000

# ClickHouse (tactical copy of the Silver layer and the star model)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=silver
CLICKHOUSE_PASSWORD=change-me-too
CLICKHOUSE_DATABASE=silver

# Local DuckDB file with the strategic views of the star model over the lake (ignored by git)
WAREHOUSE_PATH=warehouse/olist.duckdb
