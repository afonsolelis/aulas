@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam roundCorner 8
skinparam ArrowColor #2E2640
skinparam ClassBorderColor #2E2640
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E6F0FB
skinparam ComponentBorderColor #2E2640
skinparam ComponentBackgroundColor #FFFFFF
skinparam InterfaceBorderColor #2E2640
skinparam NoteBorderColor #855EDE
skinparam NoteBackgroundColor #F4EFFC
skinparam ParticipantBorderColor #2E2640
skinparam ParticipantBackgroundColor #E6F0FB
skinparam ActorBorderColor #2E2640
skinparam NodeBorderColor #2E2640
skinparam ArtifactBorderColor #2E2640
skinparam DatabaseBorderColor #2E2640
skinparam StateBorderColor #2E2640
skinparam StateBackgroundColor #FFFFFF
abstract class Job {
  # name : String
  # checks : List<QualityCheck>
  + run(runDate : Date) : RunResult
  # {abstract} read(runDate : Date) : DataFrame
  # {abstract} transform(df : DataFrame) : DataFrame
  # {abstract} write(df : DataFrame, runDate : Date)
}
class IngestionJob {
  - source : String
}
class ConformanceJob {
  - grain : List<String>
}
class GoldBuildJob {
  - kpi : String
}
interface QualityCheck {
  + evaluate(df : DataFrame) : CheckResult
}
class GrainCheck {
  - keys : List<String>
  + evaluate(df : DataFrame) : CheckResult
}
class RangeCheck {
  - column : String
  - min : Number
  - max : Number
  + evaluate(df : DataFrame) : CheckResult
}
class RunResult {
  + rowsWritten : Integer
  + rowsQuarantined : Integer
  + passed : Boolean
}
Job <|-- IngestionJob
Job <|-- ConformanceJob
Job <|-- GoldBuildJob
Job o-- "0..*" QualityCheck : checks
QualityCheck <|.. GrainCheck
QualityCheck <|.. RangeCheck
Job ..> RunResult : <<create>>
@enduml
