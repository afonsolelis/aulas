@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam roundCorner 8
skinparam ArrowColor #2E2640
skinparam ClassBorderColor #2E2640
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E6F0FB
skinparam ComponentBorderColor #2E2640
skinparam ComponentBackgroundColor #FFFFFF
skinparam InterfaceBorderColor #2E2640
skinparam NoteBorderColor #855EDE
skinparam NoteBackgroundColor #F4EFFC
skinparam ParticipantBorderColor #2E2640
skinparam ParticipantBackgroundColor #E6F0FB
skinparam ActorBorderColor #2E2640
skinparam NodeBorderColor #2E2640
skinparam ArtifactBorderColor #2E2640
skinparam DatabaseBorderColor #2E2640
skinparam StateBorderColor #2E2640
skinparam StateBackgroundColor #FFFFFF
class Supplier {
  supplierId : String
  name : String
  leadTimeDays : Integer
}
class Product {
  productId : String
  name : String
  continuousUse : Boolean
  isCritical() : Boolean
}
class Store {
  storeId : String
  city : String
  region : String
}
class StockPosition {
  date : Date
  onHand : Integer
  isStockOut() : Boolean
}
class SaleLine {
  saleId : String
  quantity : Integer
  soldAt : DateTime
}
class PurchaseOrder {
  orderId : String
  status : OrderStatus
  createdAt : DateTime
  approve()
  receive(receivedAt : DateTime)
  cancel()
}
class OrderLine {
  quantity : Integer
}
enum OrderStatus {
  CREATED
  APPROVED
  RECEIVED
  CANCELLED
}
Supplier "1" -- "1..*" Product : supplies >
Product "1" -- "0..*" StockPosition
Store "1" -- "0..*" StockPosition
Product "1" -- "0..*" SaleLine
Store "1" -- "0..*" SaleLine
Supplier "1" -- "0..*" PurchaseOrder : receives >
Store "1" -- "0..*" PurchaseOrder : places >
PurchaseOrder "1" *-- "1..*" OrderLine
OrderLine "0..*" -- "1" Product
PurchaseOrder ..> OrderStatus
note bottom of StockPosition
  {onHand >= 0}
  {unique (store, product, date)}
end note
@enduml
