@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam roundCorner 8
skinparam ArrowColor #2E2640
skinparam ClassBorderColor #2E2640
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E6F0FB
skinparam ComponentBorderColor #2E2640
skinparam ComponentBackgroundColor #FFFFFF
skinparam InterfaceBorderColor #2E2640
skinparam NoteBorderColor #855EDE
skinparam NoteBackgroundColor #F4EFFC
skinparam ParticipantBorderColor #2E2640
skinparam ParticipantBackgroundColor #E6F0FB
skinparam ActorBorderColor #2E2640
skinparam NodeBorderColor #2E2640
skinparam ArtifactBorderColor #2E2640
skinparam DatabaseBorderColor #2E2640
skinparam StateBorderColor #2E2640
skinparam StateBackgroundColor #FFFFFF
left to right direction
interface "RawPartitions" as IN
interface "ConformedEntities" as OUT
interface "QuarantineReport" as QR
component "Conformance jobs" as CJ {
  portin "raw" as p1
  portout "conformed" as p2
  portout "report" as p3
  component "Typing and parsing" as T
  component "Deduplication" as DD
  component "Key resolution" as K
  component "Invariant checks" as V
  component "Pseudonymisation" as P
  p1 --> T
  T --> DD
  DD --> K
  K --> V
  V --> P
  P --> p2
  V --> p3
}
IN )-- p1
p2 -- OUT
p3 -- QR
@enduml
